import logging
import shutil
from pathlib import Path

from scripts.tool_runner.qiskit_docs_contributor_tools import (
    configure_logging,
    run_cmd,
    check_packages,
    install_node_dependencies,
)

logger = logging.getLogger(__name__)

# On Windows, npm is a wrapper for npm.cmd, so get the correct command
npm_cmd = shutil.which("npm")

# These match the `lint` job in .github/workflows/main.yml, using the same
# step names, order, and arguments, so that passing `./check` locally means the
# same checks pass in CI. When you change one, change the other.
# The exceptions are check which need the Docker preview running

CHECKS = {
    "Check internal links": [
        npm_cmd,
        "run",
        "check:internal-links",
        "--",
        "--current-apis",
        "--dev-apis",
        "--historical-apis",
        "--qiskit-legacy-release-notes",
    ],
    "Check stale images": [npm_cmd, "run", "check:stale-images"],
    "Check markdown": [npm_cmd, "run", "check:markdown", "--", "--apis"],
    "Spellcheck": [npm_cmd, "run", "check:spelling"],
    "Check Qiskit bot config": [npm_cmd, "run", "check:qiskit-bot"],
    "Formatting": [npm_cmd, "run", "check:fmt"],
    "Check for orphan pages": [npm_cmd, "run", "check:orphan-pages", "--", "--apis"],
    "Check _toc.json entries resolve to real pages": [
        npm_cmd,
        "run",
        "check:toc",
        "--",
        "--apis",
    ],
    "Check Qiskit and Qiskit C API versions": [npm_cmd, "run", "check:qiskit-versions"],
    "Check tutorials index": ["python3", "scripts/ci/check-tutorials-index.py"],
    "Infrastructure tests": [npm_cmd, "test"],
    "Typecheck": [npm_cmd, "run", "typecheck"],
    "Check all notebooks are listed in the config file": [
        "python3",
        "scripts/ci/check-all-notebooks-are-tested.py",
    ],
    "Lint notebooks": ["tox", "-e", "lint"],
}


def main() -> None:
    check_packages()
    if not Path("./node_modules").exists():
        install_node_dependencies()
    for i, (name, cmd) in enumerate(CHECKS.items()):
        run_cmd(name, cmd, progress=f"{i + 1}/{len(CHECKS)}")
    logger.info("🎉 All checks passed!")


if __name__ == "__main__":
    try:
        configure_logging()
        main()
    except KeyboardInterrupt:
        raise SystemExit(1)
